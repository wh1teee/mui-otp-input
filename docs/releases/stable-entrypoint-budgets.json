{
  "schemaVersion": 1,
  "measurement": {
    "external": [
      "@base-ui/react",
      "@emotion/react",
      "@emotion/styled",
      "@mui/material",
      "react",
      "react-dom",
      "react-hook-form"
    ],
    "minifier": "oxc",
    "note": "Limits measure package-owned client code while keeping the consuming application's renderer, React and form peers external."
  },
  "profiles": {
    "index": {
      "renderer": "mui",
      "gzipLimit": 4700,
      "brotliLimit": 4150
    },
    "headless": {
      "renderer": "headless",
      "gzipLimit": 1100,
      "brotliLimit": 1000
    },
    "base-ui": {
      "renderer": "base-ui",
      "gzipLimit": 4050,
      "brotliLimit": 3650
    },
    "shadcn": {
      "renderer": "shadcn",
      "gzipLimit": 6900,
      "brotliLimit": 6150
    },
    "react-hook-form": {
      "renderer": "mui-rhf",
      "gzipLimit": 5150,
      "brotliLimit": 4550
    },
    "base-ui/react-hook-form": {
      "renderer": "base-ui-rhf",
      "gzipLimit": 3900,
      "brotliLimit": 3550
    },
    "shadcn/react-hook-form": {
      "renderer": "shadcn-rhf",
      "gzipLimit": 6750,
      "brotliLimit": 6050
    }
  }
}
